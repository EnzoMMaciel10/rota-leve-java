# Docker Compose lê este arquivo quando for copiado para .env.
# Maven/Java NÃO carregam .env automaticamente. Exporte as variáveis no terminal.
# Valores abaixo são somente para desenvolvimento local.
JWT_SECRET=rota-leve-chave-local-apenas-demo-com-mais-de-32-bytes
# Origens exatas para Expo Web (separe por vírgula); apps nativos não usam CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Fotos comunitárias locais; pasta precisa de volume persistente no deploy.
UPLOAD_DIRECTORY=data/fotos
RABBIT_USER=rotaleve
RABBIT_PASSWORD=rotaleve-dev
RABBIT_ENABLED=true
RABBIT_HOST=localhost
RABBIT_PORT=5672

# demo: opções sintéticas locais; google: consulta real com chave e faturamento.
ROUTES_PROVIDER=demo
GOOGLE_MAPS_API_KEY=

# iniciar-ia.cmd habilita Ollama local sem chave automaticamente.
# No Compose, suba o perfil ia, baixe o modelo e use AI_ENABLED=true, AI_CHAT_MODEL=ollama.
AI_ENABLED=false
AI_CHAT_MODEL=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Alternativa OpenAI: AI_CHAT_MODEL=openai e chave no ambiente.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Perfil prod: Oracle já provisionado e credenciais fornecidas pelo grupo.
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:oracle:thin:@//SEU_HOST:1521/SEU_SERVICE_NAME
# DB_USERNAME=SEU_USUARIO
# DB_PASSWORD=DEFINA_NO_AMBIENTE
# DB_DDL_AUTO=update
# JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_BYTES
# BOOTSTRAP_GESTOR_EMAIL=
# BOOTSTRAP_GESTOR_SENHA=
